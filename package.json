{
  "name": "catrupole",
  "version": "0.2.44",
  "description": "CATrupole Desktop App (Electron + FastAPI)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "backend": "./start-dev.sh",
    "setup": "./setup-dev.sh",
    "frontend-only": "open frontend/index.html",
    "test:update-checker": "node --test electron/update-checker.test.js",
    "test:updater": "node --test electron/update-checker.test.js electron/updater-contract.test.js",
    "build:backend": "node scripts/build-backend.js",
    "prepare:mac-build": "node scripts/prepare-mac-build.js",
    "smoke:mac": "bash scripts/smoke-test-mac.sh",
    "dist": "npm run build:backend && npm run prepare:mac-build && electron-builder --publish never",
    "dist:mac": "npm run build:backend && npm run prepare:mac-build && electron-builder --mac dmg zip --publish never",
    "dist:win": "npm run build:backend && electron-builder --win nsis portable zip --publish never",
    "dist:linux": "npm run build:backend && electron-builder --linux AppImage deb --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "jsme-editor": "^2024.4.29",
    "jspdf": "^4.2.1",
    "openchemlib": "^9.20.0",
    "plotly.js-dist-min": "^2.27.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.catrupole.desktop",
    "productName": "CATrupole",
    "asar": false,
    "afterPack": "scripts/after-pack.js",
    "icon": "build/icons/icon.png",
    "files": [
      "electron/**/*",
      "frontend/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/backend/lcms-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "spelveris",
        "repo": "lcms-desktop"
      }
    ],
    "mac": {
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.science",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico"
    },
    "linux": {
      "category": "Science",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
